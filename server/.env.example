# ============================================================
# Rekha Eye Hospital — Server Environment Configuration Template
# ============================================================
# Copy this file to .env and configure your local/production values.
# NEVER commit .env to version control.
# ============================================================

# Fast2SMS API Key (for SMS OTP / transactional alerts)
# Get your API key from: https://www.fast2sms.com/
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# WhatsApp Microservice URL (Node.js whatsapp-web.js service)
WHATSAPP_SERVICE_URL=http://localhost:3001

# Flask Secret Key & JWT Secret Key
SECRET_KEY=your_flask_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# Database Configuration
# Local SQLite default: sqlite:///reh_hospital.db
# Production PostgreSQL example: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///reh_hospital.db

# Optional Individual Database Parameters (if DATABASE_URL is not set)
# DB_HOST=localhost
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_NAME=reh_db
# DB_PORT=5432

# Application Port and Environment
PORT=5000
FLASK_ENV=development
